<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="12dp"
    app:cardCornerRadius="20dp"
    app:checkedIcon="@android:drawable/checkbox_on_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/luxury_card_bg"
        android:padding="16dp">

        <!-- Golden border top -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/golden_line"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏛️ Phòng 101 - Standard"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#8B4513"

            android:singleLine="true"
            android:ellipsize="end"
            android:shadowColor="#DAA520"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:contentDescription="Tên phòng" />

        <TextView
            android:id="@+id/txtRoomType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷️ Loại: Standard"
            android:textSize="16sp"
            android:textColor="#A0522D"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:contentDescription="Loại phòng" />

        <TextView
            android:id="@+id/txtRoomPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 500.000 ₫/đêm"
            android:textSize="18sp"
            android:textColor="#B8860B"
            android:textStyle="bold"

            android:layout_marginTop="8dp"
            android:shadowColor="#DAA520"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:contentDescription="Giá phòng mỗi đêm" />

        <TextView
            android:id="@+id/txtRoomDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👥 Tối đa 2 người • 🌿 View vườn • ⭐ Tiện ích: 1,2,3"
            android:textSize="14sp"
            android:textColor="#8B4513"
            android:layout_marginTop="8dp"
            android:alpha="0.9"
            android:contentDescription="Chi tiết phòng" />

        <!-- Golden divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/golden_line"
            android:layout_marginVertical="12dp"
            android:alpha="0.6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="Đặt Phòng"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:background="@drawable/golden_button_dark"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_book_24"
                app:iconTint="#FFFFFF"
                app:iconPadding="12dp"
                android:paddingVertical="12dp"
                android:contentDescription="Đặt phòng" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckInNow"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:text="Check-in Ngay"
                android:textColor="#8B4513"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_check_in_24"
                app:iconTint="#8B4513"
                app:strokeColor="#DAA520"
                app:rippleColor="#33DAA520"
                app:iconPadding="12dp"
                android:paddingVertical="8dp"
                android:contentDescription="Check-in ngay" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewCalendar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:text="Xem Lịch Trống"
                android:textColor="#8B4513"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_calendar_24"
                app:iconTint="#8B4513"
                app:strokeColor="#DAA520"
                app:rippleColor="#33DAA520"
                app:iconPadding="12dp"
                android:paddingVertical="8dp"
                android:contentDescription="Xem lịch trống" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>