<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="12dp"
    app:cardCornerRadius="20dp"
    app:checkedIcon="@android:drawable/checkbox_on_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/luxury_card_bg"
        android:padding="16dp">

        <!-- Golden border top -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/golden_line"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏛️ Phòng 101 - Standard"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#8B4513"
            android:fontFamily="serif"
            android:singleLine="true"
            android:ellipsize="end"
            android:shadowColor="#DAA520"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:contentDescription="Tên phòng" />

        <TextView
            android:id="@+id/txtRoomType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷️ Loại: Standard"
            android:textSize="16sp"
            android:textColor="#A0522D"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:contentDescription="Loại phòng" />

        <TextView
            android:id="@+id/txtRoomPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 500.000 ₫/đêm"
            android:textSize="18sp"
            android:textColor="#B8860B"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginTop="8dp"
            android:shadowColor="#DAA520"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:contentDescription="Giá phòng mỗi đêm" />

        <TextView
            android:id="@+id/txtRoomDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👥 Tối đa 2 người • 🌿 View vườn • ⭐ Tiện ích: 1,2,3"
            android:textSize="14sp"
            android:textColor="#8B4513"
            android:layout_marginTop="8dp"
            android:alpha="0.9"
            android:contentDescription="Chi tiết phòng" />

        <!-- Golden divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/golden_line"
            android:layout_marginVertical="12dp"
            android:alpha="0.6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewCalendar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="📅 Lịch"
                android:textSize="14sp"
                android:textColor="#8B4513"
                android:textStyle="bold"
                android:background="@drawable/golden_button_light"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                app:rippleColor="#80DAA520"
                android:contentDescription="Xem lịch trống" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookRoom"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Đặt"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/golden_button_dark"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                app:rippleColor="#80DAA520"
                android:contentDescription="Đặt phòng" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>