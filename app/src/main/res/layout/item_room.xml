<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtRoomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phòng 101 - Standard"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1A237E"
                android:maxLines="2"
                android:contentDescription="Tên phòng" />

            <androidx.cardview.widget.CardView
                android:id="@+id/statusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:elevation="2dp"
                android:backgroundTint="#4CAF50">

                <TextView
                    android:id="@+id/txtRoomStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trống"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:contentDescription="Trạng thái phòng" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:id="@+id/txtRoomType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loại: Standard"
            android:textSize="16sp"
            android:textColor="#546E7A"
            android:layout_marginTop="8dp"
            android:contentDescription="Loại phòng" />

        <TextView
            android:id="@+id/txtRoomPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="500.000 ₫/đêm"
            android:textSize="16sp"
            android:textColor="#E65100"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:contentDescription="Giá phòng mỗi đêm" />

        <TextView
            android:id="@+id/txtRoomDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tối đa 2 người, View vườn, Tiện ích: 1,2,3"
            android:textSize="14sp"
            android:textColor="#546E7A"
            android:layout_marginTop="8dp"
            android:contentDescription="Chi tiết phòng" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnViewCalendar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="📅 Lịch"
                android:textSize="14sp"
                android:textColor="#1976D2"
                android:backgroundTint="#E3F2FD"
                android:contentDescription="Xem lịch trống" />

            <Button
                android:id="@+id/btnBookRoom"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📝 Đặt"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0D6EFD"
                android:contentDescription="Đặt phòng" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>