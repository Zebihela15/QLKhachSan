<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/txtRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:contentDescription="Tên phòng" />

        <TextView
            android:id="@+id/txtRoomType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textColor="#546E7A"
            android:contentDescription="Loại phòng" />

        <TextView
            android:id="@+id/txtRoomStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textColor="#546E7A"
            android:contentDescription="Trạng thái phòng" />

        <TextView
            android:id="@+id/txtRoomDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="#546E7A"
            android:contentDescription="Chi tiết phòng" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Sửa"
                android:textSize="14sp"
                android:textColor="#1976D2"
                android:backgroundTint="#E3F2FD"
                android:contentDescription="Sửa phòng" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Xóa"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                android:contentDescription="Xóa phòng" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>