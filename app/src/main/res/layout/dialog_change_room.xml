<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvChangeRoomTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chuyển phòng"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCurrentRoomInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phòng hiện tại: 101 - VIP"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn phòng mới :"
        android:textStyle="bold"/>

    <Spinner
        android:id="@+id/spinnerAvailableRooms"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelChangeRoom"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hủy"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmChangeRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xác nhận"/>
    </LinearLayout>
</LinearLayout>