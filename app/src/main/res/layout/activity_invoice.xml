<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thông Tin Hóa Đơn"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:gravity="center" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scroll container cho nội dung -->
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="1dp">

            <!-- Mã hóa đơn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelInvoiceId"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Mã Hóa Đơn"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueInvoiceId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Tên khách hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelCustomerName"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Tên Khách Hàng"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueCustomerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Thông tin liên hệ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelContact"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Liên Hệ"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueContact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Tên phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelRoomName"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Tên Phòng"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueRoomName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Ngày nhận/trả phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelDateRange"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Ngày"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueDateRange"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Số ngày -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelDays"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Số Ngày"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueDays"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Số khách -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelGuestCount"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Số Khách"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueGuestCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Yêu cầu đặc biệt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelSpecialRequest"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Yêu Cầu Đặc Biệt"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueSpecialRequest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Không có"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Giá phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelRoomPrice"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Giá Phòng"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueRoomPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#212529" />
            </LinearLayout>

            <!-- Mã giảm giá -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/labelVoucher"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Mã Giảm Giá"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueVoucher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Không có"
                    android:textSize="14sp"
                    android:textColor="#4CAF50" />
            </LinearLayout>

            <!-- Tổng tiền -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/labelTotalPrice"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Tổng Tiền"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueTotalPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#198754" />
            </LinearLayout>

            <!-- Trạng thái -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/labelStatus"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Trạng Thái"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/valueStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N/A"
                    android:textSize="14sp"
                    android:textColor="#4CAF50"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>