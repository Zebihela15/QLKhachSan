<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đặt Phòng"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:gravity="center" />

            <ImageView
                android:id="@+id/btnRefresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

        </LinearLayout>

        <!-- Hotel Info Card -->
        <LinearLayout
            android:id="@+id/hotelCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/hotelImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="#E3F2FD"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/hotelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212529" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TP. Hồ Chí Minh"
                    android:textSize="14sp"
                    android:textColor="#6C757D"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Booking Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông Tin Đặt Phòng"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:layout_marginBottom="16dp" />

            <!-- Date Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Ngày"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/dateRange"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chọn ngày"
                    android:textSize="14sp"
                    android:textColor="#212529"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnSelectDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thay đổi"
                    android:textSize="14sp"
                    android:textColor="#0D6EFD"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Time Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Giờ"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/timeRange"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chọn giờ"
                    android:textSize="14sp"
                    android:textColor="#212529"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnSelectTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thay đổi"
                    android:textSize="14sp"
                    android:textColor="#0D6EFD"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Guest Count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Số Khách"
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

                <NumberPicker
                    android:id="@+id/numberPickerGuests"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Customer Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông Tin Khách Hàng"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editCustomerName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Họ và Tên"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:background="@null"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="1dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E9ECEF"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editCustomerPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Số Điện Thoại"
                android:textSize="14sp"
                android:inputType="phone"
                android:background="@null"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="1dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E9ECEF"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editCustomerCCCD"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="CCCD/Hộ Chiếu"
                android:textSize="14sp"
                android:inputType="number"
                android:background="@null"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="1dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E9ECEF"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editCustomerEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Email (Tùy chọn)"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:background="@null"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E9ECEF" />

        </LinearLayout>

        <!-- Additional Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tùy Chọn Thêm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editVoucherCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Mã Giảm Giá"
                android:textSize="14sp"
                android:inputType="text"
                android:background="@null"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="1dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E9ECEF"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editSpecialRequest"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Yêu Cầu Đặc Biệt"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:background="@null"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:gravity="top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E9ECEF" />

        </LinearLayout>

        <!-- Price Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng Thanh Toán"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textTotalPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 VNĐ"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#198754" />

                <TextView
                    android:id="@+id/textTotalDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#6C757D" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Giá đã bao gồm thuế và phí dịch vụ"
                android:textSize="12sp"
                android:textColor="#6C757D" />

        </LinearLayout>

        <!-- Book Button -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Xác Nhận Đặt Phòng"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="#0D6EFD"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>