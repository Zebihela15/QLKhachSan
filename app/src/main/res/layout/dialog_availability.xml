<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/luxury_card_bg">

        <!-- Header with room name and navigation -->
        <androidx.cardview.widget.CardView
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/golden_header_gradient">

                <TextView
                    android:id="@+id/dialogRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 Phòng A101 - Lịch trống"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:shadowColor="#B8860B"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />

                <!-- Month navigation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="← Tháng trước"
                        android:textSize="14sp"
                        android:textColor="#8B4513"
                        android:textStyle="bold"
                        android:background="@drawable/golden_button_light"
                        app:backgroundTint="@null"
                        app:cornerRadius="20dp"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:layout_marginEnd="8dp"
                        app:rippleColor="#80DAA520" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tháng sau →"
                        android:textSize="14sp"
                        android:textColor="#8B4513"
                        android:textStyle="bold"
                        android:background="@drawable/golden_button_light"
                        app:backgroundTint="@null"
                        app:cornerRadius="20dp"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:layout_marginStart="8dp"
                        app:rippleColor="#80DAA520" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Calendar Grid Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFEF7">

                <!-- Golden border top -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/golden_line" />

                <GridLayout
                    android:id="@+id/gridLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:rowCount="7"
                    android:padding="16dp">

                    <!-- Day headers with improved styling -->
                    <TextView android:text="T2" style="@style/CalendarHeaderCell" />
                    <TextView android:text="T3" style="@style/CalendarHeaderCell" />
                    <TextView android:text="T4" style="@style/CalendarHeaderCell" />
                    <TextView android:text="T5" style="@style/CalendarHeaderCell" />
                    <TextView android:text="T6" style="@style/CalendarHeaderCell" />
                    <TextView android:text="T7" style="@style/CalendarHeaderCell" />
                    <TextView android:text="CN" style="@style/CalendarHeaderCell" />

                    <!-- Calendar days (35 cells) -->
                    <TextView android:id="@+id/day1" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day2" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day3" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day4" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day5" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day6" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day7" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day8" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day9" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day10" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day11" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day12" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day13" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day14" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day15" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day16" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day17" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day18" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day19" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day20" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day21" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day22" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day23" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day24" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day25" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day26" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day27" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day28" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day29" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day30" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day31" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day32" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day33" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day34" style="@style/CalendarDayCell" />
                    <TextView android:id="@+id/day35" style="@style/CalendarDayCell" />
                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Legend for calendar colors -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:background="#FFFEF7">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="20dp">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#32CD32"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ Trống"
                        android:textSize="13sp"
                        android:textColor="#8B4513"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="20dp">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#DC143C"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Đã đặt"
                        android:textSize="13sp"
                        android:textColor="#8B4513"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#FFD700"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Đang sử dụng"
                        android:textSize="13sp"
                        android:textColor="#8B4513"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Close button with modern styling -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Đóng"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/golden_button_dark"
            app:backgroundTint="@null"
            app:cornerRadius="28dp"
            android:paddingHorizontal="40dp"
            android:paddingVertical="16dp"
            app:rippleColor="#80DAA520" />
    </LinearLayout>
</androidx.cardview.widget.CardView>