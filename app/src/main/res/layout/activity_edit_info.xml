<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8BBD0"
            android:padding="12dp"
            android:text="Chỉnh sửa thông tin"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Ảnh đại diện -->
        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_profile_image"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:contentDescription="Avatar"
            android:padding="8dp" />

        <!-- Họ tên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/etEditFullName"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_person"
                android:enabled="false"
                android:hint="Tên người dùng"
                android:inputType="textPersonName"
                android:padding="8dp"
                android:textColor="#000" />

            <ImageView
                android:id="@+id/btnEditFullName"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Chỉnh sửa họ tên"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Username -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etEditUsername"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_person"
                android:enabled="false"
                android:hint="Tên đăng nhập"
                android:inputType="text"
                android:padding="8dp"
                android:textColor="#000" />

            <ImageView
                android:id="@+id/btnEditUsername"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Chỉnh sửa username"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Số điện thoại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etEditPhone"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_phone"
                android:enabled="false"
                android:hint="Số điện thoại"
                android:inputType="phone"
                android:padding="8dp"
                android:textColor="#000" />

            <ImageView
                android:id="@+id/btnEditPhone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Chỉnh sửa sdt"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etEditEmail"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_mail"
                android:enabled="false"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="8dp"
                android:textColor="#000" />

            <ImageView
                android:id="@+id/btnEditEmail"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:contentDescription="Chỉnh sửa email"
                android:focusable="true"
                android:src="@drawable/ic_edit" />
        </LinearLayout>

        <!-- Nút Lưu -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu"
            android:backgroundTint="#F8BBD0"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnEditPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#F8BBD0"
            android:text="Đổi mật khẩu"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>