<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editMaPhong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mã phòng"
        android:inputType="number"
        android:required="true" />

    <Spinner
        android:id="@+id/spinnerMaLoaiPhong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editGiaPhong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Giá phòng (VND)"
        android:inputType="numberDecimal"
        android:required="true"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editSoLuongNguoiToiDa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số lượng người tối đa"
        android:inputType="number"
        android:required="true"
        android:layout_marginTop="8dp" />

    <Spinner
        android:id="@+id/spinnerTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mô tả"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editTienIch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tiện ích (ID cách nhau bằng dấu phẩy)"
        android:inputType="text"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hủy"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lưu"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>