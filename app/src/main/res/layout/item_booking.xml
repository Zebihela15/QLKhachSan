<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Colored Top Bar -->
        <View
            android:id="@+id/colorBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#667EEA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Row với Booking ID và Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textBookingId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#BK2024001"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2D3748"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã xác nhận"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"
                        app:chipBackgroundColor="#48BB78"
                        app:chipCornerRadius="16dp"
                        app:chipMinHeight="28dp"
                        android:paddingHorizontal="12dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/textTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.500.000₫"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#38A169" />

                    <TextView
                        android:id="@+id/textPriceNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng tiền"
                        android:textSize="12sp"
                        android:textColor="#A0AEC0" />

                </LinearLayout>

            </LinearLayout>

            <!-- Customer Information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F7FAFC"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin khách hàng"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#718096"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textCustomerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguyễn Văn An"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/textPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📞 0123 456 789"
                            android:textSize="13sp"
                            android:textColor="#4A5568" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Booking Details Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Left Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phòng"
                        android:textSize="12sp"
                        android:textColor="#A0AEC0"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textRoomInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏨 Deluxe - P301"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2D3748"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhận phòng"
                        android:textSize="12sp"
                        android:textColor="#A0AEC0"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textCheckInDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 15/12/2024"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2D3748" />

                </LinearLayout>

                <!-- Right Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số đêm"
                        android:textSize="12sp"
                        android:textColor="#A0AEC0"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌙 3 đêm"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2D3748"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trả phòng"
                        android:textSize="12sp"
                        android:textColor="#A0AEC0"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textCheckOutDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 18/12/2024"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2D3748" />

                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginVertical="8dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Primary Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrimaryAction"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="2"
                    android:text="Check-in"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#667EEA"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="visible" />

                <!-- Secondary Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecondaryAction"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Hủy"
                    android:textSize="13sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="#F56565"
                    app:cornerRadius="8dp"
                    android:textColor="#F56565"
                    android:layout_marginEnd="8dp"
                    android:visibility="visible" />

                <!-- Details Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Chi tiết"
                    android:textSize="13sp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:textColor="#718096"
                    app:cornerRadius="8dp"
                    android:minWidth="80dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xóa"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="#EF4444"
                    android:textColor="#EF4444"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkAsCleaned"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dọn xong"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>