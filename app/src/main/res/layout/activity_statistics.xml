<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFC"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Báo Cáo Thống Kê"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A1D29"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phân tích doanh thu và hiệu suất khách sạn"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="20dp"/>
            <Button
                android:id="@+id/btnRefreshData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Làm mới dữ liệu"
                android:textSize="16sp"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#FFFFFF" />
            <!-- Date Filter Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chọn Khoảng Thời Gian"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#374151"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Từ ngày"
                                android:textSize="12sp"
                                android:textColor="#6B7280"
                                android:layout_marginBottom="4dp"/>

                            <EditText
                                android:id="@+id/datePickerStart"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="dd/MM/yyyy"
                                android:inputType="none"
                                android:padding="12dp"
                                android:textSize="14sp"
                                android:textColor="#374151"
                                android:textColorHint="#9CA3AF"
                                android:background="@drawable/rounded_edittext_bg"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Đến ngày"
                                android:textSize="12sp"
                                android:textColor="#6B7280"
                                android:layout_marginBottom="4dp"/>

                            <EditText
                                android:id="@+id/datePickerEnd"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="dd/MM/yyyy"
                                android:inputType="none"
                                android:padding="12dp"
                                android:textSize="14sp"
                                android:textColor="#374151"
                                android:textColorHint="#9CA3AF"
                                android:background="@drawable/rounded_edittext_bg"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Revenue Overview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="120dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tổng Doanh Thu"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvTotalRevenue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 VNĐ"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:maxLines="2"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="120dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Doanh Thu Dịch Vụ"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvServiceRevenue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 VNĐ"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#3B82F6"
                        android:maxLines="2"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Charts Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doanh Thu Theo Loại Phòng"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="16dp"/>

                <WebView
                    android:id="@+id/chartRevenueByRoomType"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tỷ Lệ Sử Dụng Phòng"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="16dp"/>

                <WebView
                    android:id="@+id/chartOccupancyRate"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Statistics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Booking Statistics -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thống Kê Đặt Phòng"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Tổng đơn đặt"
                                android:textSize="12sp"
                                android:textColor="#6B7280"/>

                            <TextView
                                android:id="@+id/tvTotalBookings"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#DC2626"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Tỷ lệ hủy đơn"
                                android:textSize="12sp"
                                android:textColor="#6B7280"/>

                            <TextView
                                android:id="@+id/tvCancellationRate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#F59E0B"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nguồn đặt phòng"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvBookingSources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chưa có dữ liệu"
                        android:textSize="14sp"
                        android:textColor="#374151"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thời gian đặt trước trung bình"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvAvgBookingLeadTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 ngày"
                        android:textSize="14sp"
                        android:textColor="#374151"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Customer Statistics -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thống Kê Khách Hàng"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Khách mới / Khách cũ"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCustomerNewVsReturning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 / 0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#8B5CF6"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Room Usage Statistics -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thống Kê Sử Dụng Phòng"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Phòng đặt nhiều nhất"
                                android:textSize="12sp"
                                android:textColor="#6B7280"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/tvMostBookedRoom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Chưa có dữ liệu"
                                android:textSize="14sp"
                                android:textColor="#059669"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Phòng ít đặt nhất"
                                android:textSize="12sp"
                                android:textColor="#6B7280"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/tvLeastBookedRoom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Chưa có dữ liệu"
                                android:textSize="14sp"
                                android:textColor="#DC2626"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Check-in / Check-out"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCheckInOut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 / 0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#374151"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>