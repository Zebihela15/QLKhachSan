<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Style tùy chỉnh cho Button để loại bỏ background mặc định -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/red</item>
    </style>

    <!-- Theme chính của ứng dụng, áp dụng style Button tùy chỉnh -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:buttonStyle">@style/Widget.App.Button</item>
        <!-- Các thuộc tính khác của theme (nếu có) -->
    </style>
    <style name="CalendarHeaderCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#8B4513</item>
        <item name="android:background">@drawable/golden_button_light</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:shadowColor">#DAA520</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="CalendarDayCell">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">44dp</item>
    <item name="android:layout_columnWeight">1</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">#2F1B14</item>
    <item name="android:background">@drawable/luxury_card_bg</item>
    <item name="android:layout_margin">2dp</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:elevation">2dp</item>
</style>

    <!-- Calendar day states -->
    <style name="CalendarDayAvailable" parent="CalendarDayCell">
        <item name="android:background">@drawable/calendar_day_available</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalendarDayBooked" parent="CalendarDayCell">
        <item name="android:background">@drawable/calendar_day_booked</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalendarDayOccupied" parent="CalendarDayCell">
        <item name="android:background">@drawable/calendar_day_occupied</item>
        <item name="android:textColor">#8B4513</item>
    </style>

</resources>