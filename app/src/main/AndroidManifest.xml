<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppQLKhachSan"
        tools:targetApi="31">

        <!-- Activity chính ban đầu (AdminActivity làm màn hình chính) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".RegisterActivity" />
        <activity android:name=".migration.DataMigrationActivity" />

        <activity android:name=".MainActivity"></activity>
        <activity android:name=".RoomActivity" />
        <activity android:name=".RestaurantActivity" />
        <activity android:name=".BookingActivity" />
        <activity android:name=".admin.AdminDashboardActivity" />
        <activity android:name=".admin.AdminBookingListActivity" />
        <activity android:name=".admin.ClearDataActivity" />
        <activity android:name=".UserInfoActivity"/>
        <activity android:name=".Edit_Info_Activity"/>

        <activity android:name=".BookingHistoryActivity"/>
        <activity android:name=".InvoiceActivity"></activity>
        <!-- Các activity trong thư mục admin -->

        <!--
        <activity android:name=".admin.DiscountManagementActivity" />
        <activity android:name=".admin.RoomStatusActivity" />

        <activity android:name=".admin.InvoiceManagementActivity" />
        -->

    </application>

    <!-- Quyền truy cập ảnh (nếu cần cho upload ảnh trong RoomManagementActivity) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

</manifest>